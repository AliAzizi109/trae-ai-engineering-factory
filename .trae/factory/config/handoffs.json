{
  "schema_version": "factory-handoffs-v2.1",
  "phase_sequence": [
    "intake",
    "discovery",
    "research",
    "plan",
    "implement",
    "review",
    "security_review",
    "qa",
    "release_gate",
    "human_approval"
  ],
  "handoffs": [
    {
      "from_role": "chief_orchestrator",
      "to_role": "chief_orchestrator",
      "required_inputs": [
        "task_id",
        "objective",
        "initial_request",
        "constraints",
        "priority"
      ],
      "required_state_updates": {
        "current_phase": "discovery",
        "current_role": "chief_orchestrator",
        "status": "in_progress",
        "next_automatic_action": "Confirm scope, assumptions, and discovery targets before research handoff."
      },
      "expected_outputs": [
        "normalized_objective",
        "scoped_request",
        "discovery_targets"
      ]
    },
    {
      "from_role": "chief_orchestrator",
      "to_role": "research_docs",
      "required_inputs": [
        "task_id",
        "objective",
        "scope",
        "constraints",
        "priority",
        "discovery_notes"
      ],
      "required_state_updates": {
        "current_phase": "research",
        "current_role": "research_docs",
        "status": "in_progress",
        "next_automatic_action": "Collect factual repository evidence and document constraints before planning."
      },
      "expected_outputs": [
        "findings",
        "constraints",
        "relevant_docs_and_code_references"
      ]
    },
    {
      "from_role": "chief_orchestrator",
      "to_role": "research_docs",
      "required_inputs": [
        "task_id",
        "objective",
        "scope",
        "constraints",
        "priority"
      ],
      "required_state_updates": {
        "current_phase": "research",
        "current_role": "research_docs",
        "status": "in_progress",
        "next_automatic_action": "Collect factual repository evidence and document constraints before planning."
      },
      "expected_outputs": [
        "findings",
        "constraints",
        "relevant_docs_and_code_references"
      ]
    },
    {
      "from_role": "research_docs",
      "to_role": "planner_architect",
      "required_inputs": [
        "objective",
        "scope",
        "constraints",
        "current_findings",
        "runtime_limitations"
      ],
      "required_state_updates": {
        "current_phase": "plan",
        "current_role": "planner_architect",
        "next_automatic_action": "Produce an actionable plan and record assumptions."
      },
      "expected_outputs": [
        "plan",
        "assumptions",
        "next_implementation_step"
      ]
    },
    {
      "from_role": "planner_architect",
      "to_role": "coder_implementer",
      "required_inputs": [
        "plan",
        "target_files",
        "constraints",
        "review_expectations"
      ],
      "required_state_updates": {
        "current_phase": "implement",
        "current_role": "coder_implementer",
        "next_automatic_action": "Implement only the approved scoped changes."
      },
      "expected_outputs": [
        "changed_files",
        "implementation_notes",
        "execution_log_entries"
      ]
    },
    {
      "from_role": "coder_implementer",
      "to_role": "code_reviewer",
      "required_inputs": [
        "changed_files",
        "objective",
        "constraints",
        "implementation_notes"
      ],
      "required_state_updates": {
        "current_phase": "review",
        "current_role": "code_reviewer",
        "review_result": "pending",
        "next_automatic_action": "Review the implementation and return PASS or FAIL."
      },
      "expected_outputs": [
        "review_result",
        "findings",
        "required_fixes_or_pass"
      ]
    },
    {
      "from_role": "code_reviewer",
      "to_role": "security_reviewer",
      "required_inputs": [
        "review_result",
        "changed_files",
        "configuration_changes"
      ],
      "required_state_updates": {
        "current_phase": "security_review",
        "current_role": "security_reviewer",
        "security_result": "pending",
        "next_automatic_action": "Perform a focused security review."
      },
      "expected_outputs": [
        "security_result",
        "risk_notes",
        "required_mitigations"
      ]
    },
    {
      "from_role": "security_reviewer",
      "to_role": "qa_test_verifier",
      "required_inputs": [
        "review_result",
        "security_result",
        "changed_files",
        "available_checks"
      ],
      "required_state_updates": {
        "current_phase": "qa",
        "current_role": "qa_test_verifier",
        "qa_result": "pending",
        "next_automatic_action": "Verify what was actually tested, record qa_verification evidence, and disclose any gaps."
      },
      "expected_outputs": [
        "qa_result",
        "qa_verification",
        "verification_summary",
        "remaining_gaps"
      ]
    },
    {
      "from_role": "qa_test_verifier",
      "to_role": "git_release_gatekeeper",
      "required_inputs": [
        "review_result",
        "security_result",
        "qa_result",
        "verification_summary"
      ],
      "required_state_updates": {
        "current_phase": "release_gate",
        "current_role": "git_release_gatekeeper",
        "next_automatic_action": "Check gate readiness and list any missing approvals."
      },
      "expected_outputs": [
        "go_or_no_go",
        "missing_gate_items",
"final_recommendation"
      ]
    },
    {
      "from_role": "git_release_gatekeeper",
      "to_role": "chief_orchestrator",
      "required_inputs": [
        "review_result",
        "security_result",
        "qa_result",
        "final_recommendation"
      ],
      "required_state_updates": {
        "current_phase": "human_approval",
        "current_role": "chief_orchestrator",
        "status": "awaiting_human_approval",
        "next_automatic_action": "Request human approval or stop with a no-go summary."
      },
      "expected_outputs": [
        "approval_request",
        "final_summary",
        "final_outcome"
      ]
    }
  ],
  "event_logging_contract": {
    "append_event_on": [
      "task_creation",
      "phase_transition",
      "model_fallback",
      "review_verdict",
      "security_verdict",
      "qa_verdict",
      "blocker",
      "escalation"
    ],
    "minimum_event_fields": [
      "timestamp",
      "type",
      "role",
      "summary"
    ]
  }
}
